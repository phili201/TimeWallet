<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Einstellungen"
        android:textColor="#00E5FF"
        android:textSize="28sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Sicherheit"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:layout_marginTop="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/emergencySwitch"
        android:text="Notfall-Schalter"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Schaltet den Blocker als Wiederherstellungsfunktion aus."
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/antiAddictionSwitch"
        android:text="Anti-Sucht-Modus"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/backButton"
        android:text="Zurück"
        android:layout_marginTop="32dp"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:backgroundTint="#00E5FF"
        android:textColor="#000000"
        android:textSize="18sp" />

</LinearLayout>
