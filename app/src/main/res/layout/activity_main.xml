<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0D0D0D"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Score Card -->
        <include layout="@layout/card_panel"/>

        <TextView
            android:id="@+id/scoreEmoji"
            android:text="🔥"
            android:textSize="40sp"
            android:textColor="#00E5FF"
            android:layout_marginTop="12dp"/>

        <ProgressBar
            android:id="@+id/scoreBar"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:max="100"
            android:progress="0"
            style="?android:attr/progressBarStyleHorizontal"
            android:progressTint="#00E5FF"
            android:layout_marginTop="4dp"/>

        <!-- Social Media Timer Card -->
        <include layout="@layout/card_panel"/>

        <TextView
            android:id="@+id/socialTimer"
            android:text="0 min"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
<Button
    android:id="@+id/btnLegal"
    android:text="Rechtliches"
    android:backgroundTint="#00E5FF"
    android:textColor="#000000"
    android:layout_marginTop="24dp"/>
