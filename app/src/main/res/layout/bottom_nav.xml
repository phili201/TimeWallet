<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:gravity="center" android:background="@color/tesla_surface" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_width="match_parent" android:layout_height="78dp">
    <LinearLayout android:id="@+id/navHome" android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
        <ImageView android:src="@drawable/ic_home" android:tint="@color/tesla_blue" android:contentDescription="Home" android:layout_width="26dp" android:layout_height="26dp" />
        <TextView android:text="Home" android:textColor="@color/tesla_blue" android:textSize="11sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navTasks" android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
        <ImageView android:src="@drawable/ic_tasks" android:tint="@color/tesla_text_secondary" android:contentDescription="Aufgaben" android:layout_width="26dp" android:layout_height="26dp" />
        <TextView android:text="Aufgaben" android:textColor="@color/tesla_text_secondary" android:textSize="11sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navStats" android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
        <ImageView android:src="@drawable/ic_stats" android:tint="@color/tesla_text_secondary" android:contentDescription="Statistik" android:layout_width="26dp" android:layout_height="26dp" />
        <TextView android:text="Wallet" android:textColor="@color/tesla_text_secondary" android:textSize="11sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navSettings" android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
        <ImageView android:src="@drawable/ic_settings" android:tint="@color/tesla_text_secondary" android:contentDescription="Einstellungen" android:layout_width="26dp" android:layout_height="26dp" />
        <TextView android:text="Profil" android:textColor="@color/tesla_text_secondary" android:textSize="11sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
