<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/tesla_black"
    android:gravity="center"
    android:padding="32dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="TIMEWALLET"
        android:textColor="@color/tesla_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/blockCountdown"
        android:text="Zugang blockiert"
        android:textColor="@color/tesla_cyan"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Produktivität zuerst. Deine Social-Zeit kannst du außerhalb einer Produktivsession nutzen."
        android:textColor="@color/tesla_text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backButton"
        android:text="Zurück zur TimeWallet"
        android:layout_marginTop="28dp"
        android:layout_width="match_parent"
        android:layout_height="56dp" />
</LinearLayout>
