<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0D0D0D"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Rechtliches"
        android:textColor="#00E5FF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnHaftung"
        android:text="Haftungsausschluss"
        android:backgroundTint="#00E5FF"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnNutzung"
        android:text="Nutzungsbedingungen"
        android:backgroundTint="#00E5FF"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnDatenschutz"
        android:text="Datenschutzerklärung"
        android:backgroundTint="#00E5FF"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnLizenz"
        android:text="Lizenz"
        android:backgroundTint="#00E5FF"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

</LinearLayout>
