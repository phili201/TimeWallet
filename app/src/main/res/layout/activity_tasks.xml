<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/tesla_black" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="DEIN FOKUS" android:textColor="@color/tesla_blue" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.12" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Aufgabe wählen" android:textColor="@color/tesla_text_primary" android:textSize="30sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Mach eine produktive Aufgabe. Nach der Verifikation bekommst du Coins." android:textColor="@color/tesla_text_secondary" android:textSize="14sp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.card.MaterialCardView app:cardBackgroundColor="@color/tesla_surface" app:cardCornerRadius="20dp" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Empfohlen" android:textColor="@color/tesla_blue" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <com.google.android.material.button.MaterialButton android:id="@+id/vocabButton" android:text="📚  Vokabeln lernen   •   25 Min" android:gravity="start|center_vertical" app:cornerRadius="16dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="58dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/codingButton" android:text="💻  Coden lernen   •   45 Min" android:gravity="start|center_vertical" app:cornerRadius="16dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="58dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/schoolButton" android:text="🎓  Schulaufgaben   •   30 Min" android:gravity="start|center_vertical" app:cornerRadius="16dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="58dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/readingButton" android:text="📖  Lesen   •   25 Min" android:gravity="start|center_vertical" app:cornerRadius="16dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="58dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:text="Eigene Aufgabe" android:textColor="@color/tesla_text_primary" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/customTaskInput" android:hint="z. B. Mathe üben" android:textColor="@color/tesla_text_primary" android:textColorHint="@color/tesla_text_secondary" android:backgroundTint="@color/tesla_blue" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="56dp" />
        <EditText android:id="@+id/customMinutesInput" android:hint="Dauer in Minuten" android:inputType="number" android:textColor="@color/tesla_text_primary" android:textColorHint="@color/tesla_text_secondary" android:backgroundTint="@color/tesla_blue" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="56dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/customButton" android:text="Eigene Session starten" app:cornerRadius="18dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="56dp" />
    </LinearLayout>
</ScrollView>
