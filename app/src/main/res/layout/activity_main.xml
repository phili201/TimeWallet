<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/tesla_black"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tesla_dark_gray"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/coinsText"
            android:text="Coins: 0"
            android:textColor="@color/tesla_text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/messageText"
            android:layout_marginTop="8dp"
            android:textColor="@color/tesla_text_secondary"
            android:textSize="14sp"
            android:text="" />
    </LinearLayout>

    <include
        android:id="@+id/cardPanel"
        layout="@layout/card_panel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:weightSum="2">

        <EditText
            android:id="@+id/taskInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Aufgabe"
            android:textColor="@color/tesla_text_primary"
            android:backgroundTint="@color/tesla_blue"
            android:padding="12dp" />

        <EditText
            android:id="@+id/durationInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Minuten"
            android:inputType="number"
            android:layout_marginStart="8dp"
            android:textColor="@color/tesla_text_primary"
            android:backgroundTint="@color/tesla_blue"
            android:padding="12dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/startSessionButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Session"
        android:layout_marginTop="12dp"
        android:textColor="@color/tesla_text_primary"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/tesla_blue" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/finishSessionButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Foto (Session beenden)"
        android:layout_marginTop="8dp"
        android:textColor="@color/tesla_text_primary"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/tesla_cyan" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/bottom_nav" />

</LinearLayout>
